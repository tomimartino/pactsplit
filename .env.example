# Public configuration only. Never put a wallet private key in the web app.
# Use 5042002 for Arc testnet; use 5042 only after a real mainnet deployment.
NEXT_PUBLIC_PACTSPLIT_CHAIN_ID=5042002
NEXT_PUBLIC_PACTSPLIT_ADDRESS=
NEXT_PUBLIC_PACTSPLIT_DEPLOYMENT_BLOCK=0
# Optional: historical trusted deployments, comma-separated addresses on the SAME chain.
NEXT_PUBLIC_PACTSPLIT_PREVIOUS_ADDRESSES=
